{
  "name": "niftic-app-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "niftic": {
    "_comment": "Consumed and then deleted by `pnpm configure`. Absent from generated apps.",
    "engineOnly": [
      "yaml"
    ],
    "engineScripts": [
      "configure"
    ],
    "provisional": [
      "@sveltejs/adapter-node",
      "@sveltejs/adapter-vercel"
    ],
    "_capabilityComment": "Base modules that exist only when a capability is on. Turning the capability off prunes the paths and drops the deps, so a static app's lockfile carries no mail SDK.",
    "capabilityDeps": {
      "email": [
        "resend"
      ]
    },
    "capabilityPaths": {
      "email": [
        "src/lib/server/email"
      ]
    }
  },
  "scripts": {
    "configure": "tsx scripts/configure/index.ts",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "resend": "6.18.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "sveltekit-superforms": "2.30.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
